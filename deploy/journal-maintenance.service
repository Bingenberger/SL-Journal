[Unit]
Description=Schulleitungsjournal – Löschfristen und verschlüsselte Sicherung

[Service]
Type=oneshot
User=journal
Group=journal
WorkingDirectory=/opt/schulleitungsjournal
EnvironmentFile=/etc/schulleitungsjournal/journal.env
ExecStart=/opt/schulleitungsjournal/.venv/bin/python manage.py maintenance
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/schulleitungsjournal /var/backups/schulleitungsjournal
